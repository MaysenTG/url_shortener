<% if notice %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__brand">URL Shortener</h1>
      <p class="hero__lede">Paste a messy link. Get something shareable with live click stats when you need them.</p>
      <div class="hero__form">
        <%= render "form", url: @url %>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__postmark">
        Post
        <span>Mark</span>
      </div>
      <div class="hero__ribbon">
        <div class="hero__url-long">https://example.com/articles/2026/how-to-share-without-the-mess?ref=newsletter&amp;utm=long</div>
        <div class="hero__url-short"><%= request.host_with_port %>/a7k2m9</div>
      </div>
    </div>
  </div>
</section>

<%= render "urls/partials/features" %>
<%= render "urls/partials/modals" %>
