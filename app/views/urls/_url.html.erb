<div id="<%= dom_id url %>">
  <p>
    <strong>Original url:</strong>
    <%= url.original_url %>
  </p>

  <p>
    <strong>Shortened url:</strong>
    <%= url.shortened_url %>
  </p>

  <p>
    <strong>Clicks:</strong>
    <%= url.clicks %>
  </p>

  <p>
    <strong>Unique clicks:</strong>
    <%= url.unique_clicks %>
  </p>

  <% if url.expires_at.present? %>
    <p>
      <strong>Expires:</strong>
      <%= url.expires_at %>
    </p>
  <% end %>
</div>
