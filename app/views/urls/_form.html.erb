<div class="panel panel--hero">
  <%= form_with(model: url, id: "create-url-form") do |form| %>
    <% if url.errors.any? %>
      <div class="form-errors">
        <h2><%= t("forms.new.errors.title") %></h2>
        <strong><%= t("forms.new.errors.correction") %></strong>
        <ul>
          <% url.errors.each do |error| %>
            <% if error.options[:message] %>
              <li><%= error.options[:message] %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>

    <h2 class="panel__title"><%= t("forms.new.title") %></h2>

    <div class="mb-3">
      <label for="original_url"><%= t("forms.new.input_label") %></label>
      <%= form.text_field :original_url, id: "original_url", class: "form-control", placeholder: t("forms.new.input_placeholder"), autocomplete: "url" %>
    </div>

    <button class="w-100 btn btn-lg btn-primary" type="submit"><%= t("forms.new.submit_button") %></button>
  <% end %>
</div>
