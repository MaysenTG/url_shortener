<section class="features">
  <h2 class="features__heading"><%= t("features.heading") %></h2>

  <div class="row row-cols-1 row-cols-md-2 align-items-md-start g-4 g-md-5">
    <div class="col features__intro">
      <h3><%= t("features.subheading") %></h3>
      <p><%= t("features.paragraph") %></p>
    </div>

    <div class="col">
      <div class="feature-grid">
        <div class="feature-item">
          <h4><i class="bi bi-gift" aria-hidden="true"></i> <%= t("features.feature1.heading") %></h4>
          <p><%= t("features.feature1.paragraph").html_safe %></p>
        </div>

        <div class="feature-item">
          <h4><i class="bi bi-lightning-charge" aria-hidden="true"></i> <%= t("features.feature2.heading") %></h4>
          <p><%= t("features.feature2.paragraph").html_safe %></p>
        </div>

        <div class="feature-item">
          <h4><i class="bi bi-graph-up" aria-hidden="true"></i> <%= t("features.feature3.heading") %></h4>
          <p><%= t("features.feature3.paragraph").html_safe %></p>
        </div>

        <div class="feature-item">
          <h4><i class="bi bi-hand-index-thumb" aria-hidden="true"></i> <%= t("features.feature4.heading") %></h4>
          <p><%= t("features.feature4.paragraph").html_safe %></p>
        </div>
      </div>
    </div>
  </div>
</section>
